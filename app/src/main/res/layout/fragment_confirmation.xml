<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">
    <LinearLayout
        style="@style/HomeSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <include layout="@layout/navigation_stock" />
        <LinearLayout
            style="@style/HomeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/confirm_title"
                android:textStyle="bold"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/confirm_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/confirm_question" />
            <LinearLayout
                android:id="@+id/selected_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/confirm_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/confirm_note" />
            <Button
                android:id="@+id/confirm_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/confirm_send"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                android:textColor="@android:color/white" />
            <Button
                android:id="@+id/cancel_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cancel_send"
                android:minHeight="48dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
