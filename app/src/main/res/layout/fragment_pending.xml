<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">
    <LinearLayout
        style="@style/HomeSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <include layout="@layout/navigation_stock" />
        <LinearLayout
            style="@style/HomeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/queue_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/queue_title"
                android:textStyle="bold"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/queue_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/queue_help" />
            <LinearLayout
                android:id="@+id/queued"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <Button
                android:id="@+id/edit_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/edit_list"
                android:minHeight="48dp"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/delete_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/delete_lists"
                android:minHeight="48dp"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/send_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/send_lists"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                android:textColor="@android:color/white" />
            <TextView
                android:id="@+id/queue_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/queue_footer" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
