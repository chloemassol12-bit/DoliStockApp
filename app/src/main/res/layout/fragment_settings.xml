<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">
    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            style="@style/ScreenTitle"
            android:id="@+id/settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_title" />
        <TextView
            android:id="@+id/api_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/api_label" />
        <TextView
            android:id="@+id/api_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/api_url"
            android:background="@drawable/surface_card"
            android:padding="14dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/account_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/account_label" />
        <TextView
            android:id="@+id/account_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/account_name"
            android:background="@drawable/surface_card"
            android:padding="14dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/key_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_label" />
        <TextView
            android:id="@+id/masked_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/masked_key"
            android:background="@drawable/surface_card"
            android:padding="14dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/depot_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/depot_label" />
        <Spinner
            android:id="@+id/default_depot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />
        <TextView
            android:id="@+id/sync_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sync_summary"
            android:background="@drawable/surface_card"
            android:padding="14dp"
            android:textSize="16sp" />
        <Button
            style="@style/StockPrimary"
            android:id="@+id/settings_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_sync"
            android:minHeight="48dp"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/change_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/change_account"
            android:minHeight="48dp"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
