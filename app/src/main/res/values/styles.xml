<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:buttonStyle">@style/StockButton</item>
        <item name="android:editTextStyle">@style/StockInput</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/header_surface</item>
        <item name="android:navigationBarColor">@color/header_surface</item>
    </style>
    <style name="LoginLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="LoginField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/login_field</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="StockButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/action_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/action_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="StockPrimary" parent="StockButton">
        <item name="android:background">@drawable/action_primary</item>
        <item name="android:textColor">@color/action_primary</item>
    </style>
    <style name="StockInput" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/login_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ScreenTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
